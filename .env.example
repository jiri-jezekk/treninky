# PostgreSQL (Neon nebo lokální Postgres). Nikdy necommituj skutečné hodnoty.
# Běh aplikace — na Neonu adresa s "-pooler".
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# Migrace — táž adresa BEZ "-pooler". Přes pooler migrace padají na
# P1002 („timed out acquiring advisory lock“): pooler pracuje po
# transakcích a zámek proti dvěma souběžným migracím mu propadne.
# U lokálního Postgresu sem dej totéž co do DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# NextAuth — náhodný řetězec (openssl rand -base64 32)
AUTH_SECRET="nahodny-retezec-min-32-znaku"

# Veřejná URL aplikace (pro cookies / redirect). Lokálně:
AUTH_URL="http://localhost:3000"
# Na Vercelu: https://tvuj-projekt.vercel.app

# "false" = zakázat registraci nových účtů (doporučeno na produkci, jen ty s heslem)
ALLOW_REGISTRATION="true"
