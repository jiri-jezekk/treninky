# PostgreSQL (Neon nebo lokální Postgres). Nikdy necommituj skutečné hodnoty.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# NextAuth — náhodný řetězec (openssl rand -base64 32)
AUTH_SECRET="nahodny-retezec-min-32-znaku"

# Veřejná URL aplikace (pro cookies / redirect). Lokálně:
AUTH_URL="http://localhost:3000"
# Na Vercelu: https://tvuj-projekt.vercel.app

# "false" = zakázat registraci nových účtů (doporučeno na produkci, jen ty s heslem)
ALLOW_REGISTRATION="true"
