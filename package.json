{
  "name": "treninky-cursor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && prisma migrate deploy",
    "start": "next start",
    "lint": "eslint",
    "check:fields": "node --experimental-strip-types scripts/check-required-fields.ts",
    "check:vs": "node --experimental-strip-types scripts/test-variable-symbol.ts",
    "check:pricing": "node --experimental-strip-types scripts/test-pricing.ts",
    "check:prepaid": "node --experimental-strip-types scripts/test-prepaid.ts",
    "check:billing": "node --experimental-strip-types scripts/test-billing.ts",
    "check:slots": "node --experimental-strip-types scripts/test-slots.ts",
    "check:plan": "node --experimental-strip-types scripts/test-plan.ts",
    "gen:prisma-stub": "node --experimental-strip-types scripts/generate-prisma-stub.ts",
    "check:types": "npm run gen:prisma-stub && tsc -p tsconfig.check.json --noEmit",
    "check": "npm run check:types && npm run check:fields && npm run check:vs && npm run check:pricing && npm run check:prepaid && npm run check:billing && npm run check:slots && npm run check:plan",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcryptjs": "^3.0.3",
    "next": "16.2.3",
    "next-auth": "5.0.0-beta.30",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "prisma": "6.19.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
