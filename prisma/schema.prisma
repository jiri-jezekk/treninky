generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Běh aplikace jde přes Neon pooler — krátkých spojení je hodně.
  url      = env("DATABASE_URL")
  // Migrace musí jít napřímo. Pooler pracuje po transakcích a zámek,
  // kterým se Prisma jistí proti dvěma migracím naráz, mu propadne —
  // deploy pak spadne na P1002 „timed out acquiring advisory lock“.
  // Stejná adresa bez „-pooler“.
  directUrl = env("DIRECT_URL")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

/**
 * Účetní druh příjmu. Spolek má u každého jiný daňový režim, proto to
 * evidujeme u zdroje — jinak se to při uzávěrce dohledává ručně z výpisu.
 */
enum IncomeKind {
  MEMBERSHIP
  TRAINING
  EVENT
  GOODS
  OTHER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  bankIban     String?
  /** Údaje spolku pro sestavy a doklady. */
  clubName     String?
  clubIco      String?
  /** Jak se účetně chovají měsíční platby za tréninky. */
  monthlyIncomeKind IncomeKind @default(TRAINING)
  createdAt    DateTime @default(now())
  players      Player[]
  groups       Group[]
  trainings    Training[]
  sharedPayments SharedPayment[]
  monthlyPaymentMarks MonthlyPaymentMark[]
  paymentBatches PaymentBatch[]
  seasons      Season[]
  prepayments  Prepayment[]
  trainingSlots TrainingSlot[]
  drills       Drill[]
}

/**
 * Kategorie hráčů. Dřív to byl pevný enum PlayerGroup, teď běžná data —
 * trenér si je přidává, přejmenovává a maže sám.
 */
model Group {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("#0ea5e9")
  sortOrder Int      @default(0)
  /** Není-li null, hráči v této kategorii platí tuto cenu za trénink místo běžné sazby. */
  discountPriceCents Int?
  createdAt DateTime @default(now())
  members   PlayerGroupMembership[]

  @@unique([userId, name])
  @@index([userId])
}

model Player {
  id           String                     @id @default(cuid())
  userId       String
  user         User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  /** Pořadové číslo hráče v klubu — základ variabilního symbolu. */
  number       Int
  active       Boolean                    @default(true)
  /** Tajný token do veřejné adresy /p/<token>, kde hráč vidí své platby. */
  payToken     String                     @unique
  /** Heslo k platebnímu odkazu — hráč si ho nastaví při prvním otevření. */
  passwordHash String?
  passwordSetAt DateTime?
  createdAt    DateTime                   @default(now())
  attendances  Attendance[]
  sharedParts  SharedPaymentParticipant[]
  groupMembers PlayerGroupMembership[]
  monthlyPaymentMarks MonthlyPaymentMark[]
  paymentBatches PaymentBatch[]
  prepayments  Prepayment[]

  @@unique([userId, number])
  @@index([userId])
}

/**
 * Sezóna — číselník období, na která se předplácí. Existuje proto, aby se
 * datum od–do zadávalo jednou a ne u každého hráče znovu.
 */
model Season {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  /** Pořadové číslo sezóny v klubu — poslední část variabilního symbolu předplatného. */
  number    Int
  /** Hranice včetně — trénink v tyhle dny už/ještě do sezóny patří. */
  startsOn  DateTime @db.Date
  endsOn    DateTime @db.Date
  /** Nabízená cena předplatného; u hráče se dá přepsat. */
  defaultPriceCents Int?
  /** Účetní druh příjmu předplatného — kam částka patří v uzávěrce. */
  incomeKind IncomeKind @default(TRAINING)
  createdAt DateTime @default(now())
  prepayments Prepayment[]

  @@unique([userId, name])
  @@unique([userId, number])
  @@index([userId, startsOn])
}

/**
 * Předplatné jednoho hráče na jedno období.
 *
 * Období je uložené u předplatného, ne u sezóny, schválně: hráč, který
 * nastoupí v půlce roku, má vlastní datum od, a pozdější sezóna nikdy
 * nepřepíše, co bylo předplacené dřív. Tréninky v období se hráči
 * neúčtují do měsíční platby — místo nich platí tuhle jednu částku.
 */
model Prepayment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  /** Null = období zadané ručně mimo číselník sezón. */
  seasonId  String?
  season    Season?  @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  startsOn  DateTime @db.Date
  endsOn    DateTime @db.Date
  /** 0 = jen vyjmutí z účtování, žádná platba se hráči nezobrazí. */
  amountCents Int    @default(0)
  vs        String   @unique
  incomeKind IncomeKind @default(TRAINING)
  note      String?
  paidAt    DateTime?
  createdAt DateTime @default(now())

  @@unique([playerId, seasonId])
  @@index([userId, startsOn])
  @@index([playerId])
}

/**
 * Souhrnná platba — hráč zaplatí víc položek jednou částkou.
 * Rozpad v položkách je to, co z ní dělá doložitelný účetní záznam.
 */
model PaymentBatch {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playerId   String
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  vs         String   @unique
  totalCents Int
  createdAt  DateTime @default(now())
  paidAt     DateTime?
  items      PaymentBatchItem[]

  @@index([userId, createdAt])
}

model PaymentBatchItem {
  id              String       @id @default(cuid())
  batchId         String
  batch           PaymentBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  kind            IncomeKind
  label           String
  amountCents     Int
  /** Odkud položka pochází — měsíc tréninků, akce, nebo předplacené období. */
  year            Int?
  month           Int?
  sharedPaymentId String?
  prepaymentId    String?

  @@index([batchId])
}

/** Označení „platba za měsíc dorazila“ — jeden záznam na hráče a kalendářní měsíc. */
model MonthlyPaymentMark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  year      Int
  month     Int
  createdAt DateTime @default(now())

  @@unique([userId, playerId, year, month])
  @@index([userId, year, month])
}

model PlayerGroupMembership {
  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  groupId  String
  group    Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([playerId, groupId])
  @@index([groupId])
}

/**
 * Rozvrh — pravidelné termíny klubu. Dřív byly úterý a čtvrtek napevno
 * v kódu a generátor uměl jen jeden čas pro oba dny, takže rozvrh
 * „úterý 18:00, čtvrtek 19:30“ jím nešel zadat vůbec.
 */
model TrainingSlot {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /** Den v týdnu jako v JS: 0 = neděle … 6 = sobota. */
  dayOfWeek Int
  /** Minuty od půlnoci — snadno se řadí i porovnává. */
  startMinutes Int
  endMinutes   Int
  /** Cena za tento termín. Zvýhodněné kategorie platí dál svou sazbu. */
  priceCents Int
  /** Vypnutý termín se nenabízí ke generování, ale historii nechává být. */
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  trainings Training[]

  @@unique([userId, dayOfWeek, startMinutes])
  @@index([userId, dayOfWeek])
}

model Training {
  id                String       @id @default(cuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  startsAt          DateTime
  /** Konec tréninku. Null u starších záznamů, kdy se délka neevidovala. */
  endsAt            DateTime?
  /** Z jakého termínu rozvrhu vznikl. Null = ručně přidaný. */
  slotId            String?
  slot              TrainingSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  cancelled         Boolean      @default(false)
  notes             String?
  /** Null = automatická cena podle dne. Není null = cena za tento trénink (z rozvrhu nebo ručně). */
  defaultPriceCents Int?
  attendances       Attendance[]
  blocks            TrainingBlock[]

  @@index([userId, startsAt])
}

/** Druh cvičení — kvůli řazení a filtrování v knihovně. */
enum DrillKind {
  WARMUP
  DRILL
  GAME
  COOLDOWN
}

/**
 * Knihovna cvičení. Trenér si ji plní postupně a pak z ní skládá
 * plány jednotlivých tréninků, místo aby psal přípravu znovu do telefonu.
 */
model Drill {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  /** Nabídne se jako délka při vložení do plánu. */
  defaultMinutes Int?
  kind           DrillKind @default(DRILL)
  /** Co je na cvičení potřeba — míče, kužely… */
  equipment      String?
  /** Archivované se nenabízí, ale zůstává v už hotových plánech. */
  archived       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  blocks         TrainingBlock[]

  @@unique([userId, name])
  @@index([userId, archived])
}

/**
 * Jeden bod plánu tréninku. Buď odkazuje na cvičení z knihovny, nebo
 * stojí sám (jednorázová věc, kterou nemá smysl ukládat).
 */
model TrainingBlock {
  id         String    @id @default(cuid())
  trainingId String
  training   Training  @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  /** Null = bod mimo knihovnu, nebo cvičení mezitím smazané. */
  drillId    String?
  drill      Drill?    @relation(fields: [drillId], references: [id], onDelete: SetNull)
  /** Vlastní název bodu. Kopíruje se z cvičení, dá se přepsat. */
  title      String
  notes      String?
  minutes    Int
  kind       DrillKind @default(DRILL)
  sortOrder  Int
  /**
   * Rozdělení do týmů u herních bodů: [{ "name": "…", "playerIds": [...] }].
   * Schválně jako JSON, ne tabulka — je to momentka jednoho večera,
   * nic se přes ni nevykazuje a hráč smazaný ze soupisky se prostě
   * při čtení přeskočí.
   */
  teams      Json?

  @@index([trainingId, sortOrder])
}

model Attendance {
  id         String           @id @default(cuid())
  trainingId String
  training   Training         @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  playerId   String
  player     Player           @relation(fields: [playerId], references: [id], onDelete: Cascade)
  status     AttendanceStatus @default(ABSENT)

  @@unique([trainingId, playerId])
}

model SharedPayment {
  id               String                     @id @default(cuid())
  userId           String
  user             User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  totalAmountCents Int
  /** Pořadové číslo akce v klubu — druhá část variabilního symbolu. */
  number           Int
  /** Účetní druh příjmu této akce — určuje, kam částka patří v uzávěrce. */
  incomeKind       IncomeKind                 @default(EVENT)
  archived         Boolean                    @default(false)
  createdAt        DateTime                   @default(now())
  participants     SharedPaymentParticipant[]

  @@unique([userId, number])
  @@index([userId, archived])
}

model SharedPaymentParticipant {
  id              String        @id @default(cuid())
  sharedPaymentId String
  sharedPayment   SharedPayment @relation(fields: [sharedPaymentId], references: [id], onDelete: Cascade)
  playerId        String
  player          Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  amountCents     Int
  paidAt          DateTime?

  @@unique([sharedPaymentId, playerId])
}
