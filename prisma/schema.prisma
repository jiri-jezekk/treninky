generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Běh aplikace jde přes Neon pooler — krátkých spojení je hodně.
  url      = env("DATABASE_URL")
  // Migrace musí jít napřímo. Pooler pracuje po transakcích a zámek,
  // kterým se Prisma jistí proti dvěma migracím naráz, mu propadne —
  // deploy pak spadne na P1002 „timed out acquiring advisory lock“.
  // Stejná adresa bez „-pooler“.
  directUrl = env("DIRECT_URL")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

/** Posilovna se počítá do ratingu, ale neúčtuje se — chodí se na ni po svém. */
enum TrainingKind {
  TRAINING
  GYM
}

/**
 * Účetní druh příjmu. Spolek má u každého jiný daňový režim, proto to
 * evidujeme u zdroje — jinak se to při uzávěrce dohledává ručně z výpisu.
 */
enum IncomeKind {
  MEMBERSHIP
  TRAINING
  EVENT
  GOODS
  OTHER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  bankIban     String?
  /** Údaje spolku pro sestavy a doklady. */
  clubName     String?
  clubIco      String?
  /** Jak se účetně chovají měsíční platby za tréninky. */
  monthlyIncomeKind IncomeKind @default(TRAINING)
  /**
   * Hráčům se v jejich odkazu ukazují jen platby od tohohle dne.
   * Starší sezóna zůstává trenérovi, hráče už nezajímá.
   */
  playerVisibleFrom DateTime? @db.Date
  createdAt    DateTime @default(now())
  players      Player[]
  groups       Group[]
  trainings    Training[]
  sharedPayments SharedPayment[]
  monthlyPaymentMarks MonthlyPaymentMark[]
  paymentBatches PaymentBatch[]
  seasons      Season[]
  prepayments  Prepayment[]
  trainingSlots TrainingSlot[]
  drills       Drill[]
  duels        Duel[]
  challenges   Challenge[]
  matches      Match[]
  soloSessions SoloSession[]
  ratingEntries RatingEntry[]
  ratingSeasons RatingSeason[]
  videoReviews  VideoReview[]
  reviewEventTypes ReviewEventType[]
}

/**
 * Kategorie hráčů. Dřív to byl pevný enum PlayerGroup, teď běžná data —
 * trenér si je přidává, přejmenovává a maže sám.
 */
model Group {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("#0ea5e9")
  sortOrder Int      @default(0)
  /** Není-li null, hráči v této kategorii platí tuto cenu za trénink místo běžné sazby. */
  discountPriceCents Int?
  createdAt DateTime @default(now())
  members   PlayerGroupMembership[]

  @@unique([userId, name])
  @@index([userId])
}

model Player {
  id           String                     @id @default(cuid())
  userId       String
  user         User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  /** Pořadové číslo hráče v klubu — základ variabilního symbolu. */
  number       Int
  active       Boolean                    @default(true)
  /** Tajný token do veřejné adresy /p/<token>, kde hráč vidí své platby. */
  payToken     String                     @unique
  /** Heslo k platebnímu odkazu — hráč si ho nastaví při prvním otevření. */
  passwordHash String?
  passwordSetAt DateTime?
  createdAt    DateTime                   @default(now())
  attendances  Attendance[]
  sharedParts  SharedPaymentParticipant[]
  groupMembers PlayerGroupMembership[]
  monthlyPaymentMarks MonthlyPaymentMark[]
  paymentBatches PaymentBatch[]
  prepayments  Prepayment[]
  /**
   * Rating po sezónách. Body za docházku se sem nepřičítají —
   * dopočítávají se, aby se samy srovnaly, když trenér účast opraví.
   */
  ratings      PlayerRating[]
  ratingEntries RatingEntry[]
  duelsChallenged Duel[]                 @relation("DuelChallenger")
  duelsFaced      Duel[]                 @relation("DuelOpponent")
  challengeEntries ChallengeEntry[]
  matchTeams   MatchTeamMember[]
  soloSessions SoloSession[]
  reviewEvents ReviewEvent[]
  reviewShares ReviewShare[]
  reviewRoster ReviewRoster[]
  /** Vypnuté = hráč se do ratingu nepočítá a v žebříčku není. */
  inRating     Boolean                   @default(true)

  @@unique([userId, number])
  @@index([userId])
}

/**
 * Jak se výsledek měří. Rozhoduje o zadávání i o zobrazení: na body
 * je to holé číslo, na čas se píše „1:23,45“ a ukládá v sekundách.
 * Dřív se čas zadával jedním číslem sekund, takže se psaly celé
 * vteřiny a desetiny se ztrácely.
 */
enum Measure {
  POINTS
  TIME
}

enum DuelStatus {
  PENDING
  ACCEPTED
  REPORTED
  CONFIRMED
  DECLINED
}

/**
 * Duel dvou hráčů. Výsledek zapíše jeden, potvrdí druhý — teprve pak
 * se hne rating. Bez potvrzení by si každý mohl připsat výhru a
 * žebříček by přestal něco znamenat.
 */
model Duel {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  seasonId       String
  season         RatingSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  /** Duel si hráči pojmenují sami — žádný číselník disciplín. */
  name           String
  description    String?
  /** false, když vyhrává nižší hodnota (čas). */
  higherWins     Boolean    @default(true)
  /** Na body, nebo na čas. Kdo vyhrává, říká higherWins. */
  measure        Measure    @default(POINTS)
  /** Duel je nejlehčí ze tří vah. */
  weightPercent  Int        @default(100)
  challengerId   String
  challenger     Player     @relation("DuelChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponentId     String
  opponent       Player     @relation("DuelOpponent", fields: [opponentId], references: [id], onDelete: Cascade)
  status         DuelStatus @default(PENDING)
  challengerValue Float?
  opponentValue   Float?
  /** Kdo výsledek zapsal — ten ho už nemůže sám potvrdit. */
  reportedById   String?
  note           String?
  /** Změny ratingu při potvrzení; drží se, aby šel duel číst i zpětně. */
  challengerDelta Int?
  opponentDelta   Int?
  createdAt      DateTime   @default(now())
  confirmedAt    DateTime?

  @@index([userId, status])
  @@index([challengerId])
  @@index([opponentId])
}

/** Měsíční výzva — kdokoli zapíše výsledek, po uzavření se rozdá rating podle pořadí. */
model Challenge {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  seasonId     String
  season       RatingSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  unit         String?
  higherWins   Boolean     @default(true)
  /** Na body, nebo na čas. Kdo vyhrává, říká higherWins. */
  measure      Measure     @default(POINTS)
  /** Měsíční výzva je z trojice nejtěžší. */
  weightPercent Int        @default(200)
  startsOn     DateTime    @db.Date
  endsOn       DateTime    @db.Date
  /** Vyplněné = pořadí vyhodnoceno a rating rozdán. Podruhé to nejde. */
  closedAt     DateTime?
  createdAt    DateTime    @default(now())
  entries      ChallengeEntry[]

  @@index([userId, endsOn])
}

model ChallengeEntry {
  id          String    @id @default(cuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  playerId    String
  player      Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  value       Float
  note        String?
  createdAt   DateTime  @default(now())

  /**
   * Jeden řádek = jeden pokus, ne konečný výsledek. Hráč jich ve výzvě
   * smí mít libovolně a do pořadí se počítá ten nejlepší — proto tu
   * dvojice (výzva, hráč) není unikátní, jen indexovaná.
   */
  @@index([challengeId, playerId])
  @@index([playerId])
}

/**
 * Ratingová sezóna. Rating platí vždycky na jednu — na začátku nové
 * začínají všichni znovu na 1000, aby loňská forma nedržela pořadí
 * zabetonované. Je to vlastní číselník, ne ten od předplatného:
 * předplacené období končí v červnu, ale rating se sbírá jen do května.
 */
model RatingSeason {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  startsOn  DateTime @db.Date
  endsOn    DateTime @db.Date
  createdAt DateTime @default(now())
  ratings   PlayerRating[]
  duels     Duel[]
  matches   Match[]
  challenges Challenge[]
  entries   RatingEntry[]

  @@unique([userId, name])
  @@index([userId, startsOn])
}

/** Rating jednoho hráče v jedné sezóně. */
model PlayerRating {
  id       String       @id @default(cuid())
  seasonId String
  season   RatingSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  playerId String
  player   Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  points   Int          @default(1000)

  @@unique([seasonId, playerId])
  @@index([playerId])
}

/**
 * Individuální trénink, který si hráč zapíše sám — házení, posilovna,
 * běh. Počítá se stejně jako účast na klubovém tréninku: +1.
 *
 * Za den jich může být víc — dopoledne házení, večer fitko — a počítají
 * se všechny. Proti nakliknutí ratingu z gauče stojí denní strop
 * v akci, ne v databázi.
 */
model SoloSession {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playerId    String
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  performedOn DateTime @db.Date
  name        String
  note        String?
  createdAt   DateTime @default(now())

  @@index([playerId, performedOn])
  @@index([userId, performedOn])
}

enum RatingSource {
  DUEL
  MATCH
  CHALLENGE
  COACH
}

/**
 * Zápas týmů — dva týmy na tréninku, nebo turnájek o čtyřech.
 *
 * Váhou stojí mezi duelem a měsíční výzvou: hraje se víc lidí naráz,
 * takže výsledek znamená víc než souboj dvou, ale míň než výzva
 * na celý měsíc.
 */
model Match {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  seasonId      String
  season        RatingSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  /** Zápas je střední váha ze tří. */
  weightPercent Int          @default(150)
  playedOn      DateTime     @db.Date
  /** Odkud vznikl, když se hrál na tréninku. */
  trainingId    String?
  training      Training?    @relation(fields: [trainingId], references: [id], onDelete: SetNull)
  /** Vyplněné = rating rozdaný. Podruhé to nejde. */
  closedAt      DateTime?
  createdAt     DateTime     @default(now())
  teams         MatchTeam[]
  videoReviews  VideoReview[]

  @@index([userId, playedOn])
  @@index([seasonId])
}

model MatchTeam {
  id        String  @id @default(cuid())
  matchId   String
  match     Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int
  /** Vyšší je vždycky lepší — u zápasů se body počítají nahoru. */
  score     Float   @default(0)
  /** Kolik dostal každý člen při uzavření. */
  delta     Int?
  members   MatchTeamMember[]

  @@index([matchId])
}

model MatchTeamMember {
  teamId   String
  team     MatchTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerId String
  player   Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([teamId, playerId])
  @@index([playerId])
}

/** Historie změn ratingu — aby šlo dohledat, odkud se kdo kam dostal. */
model RatingEntry {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  seasonId    String
  season      RatingSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  playerId    String
  player      Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  source      RatingSource
  delta       Int
  /** Rating hráče po této změně. */
  ratingAfter Int
  label       String
  duelId      String?
  matchId     String?
  challengeId String?
  createdAt   DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([playerId, createdAt])
}

/**
 * Sezóna — číselník období, na která se předplácí. Existuje proto, aby se
 * datum od–do zadávalo jednou a ne u každého hráče znovu.
 */
model Season {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  /** Pořadové číslo sezóny v klubu — poslední část variabilního symbolu předplatného. */
  number    Int
  /** Hranice včetně — trénink v tyhle dny už/ještě do sezóny patří. */
  startsOn  DateTime @db.Date
  endsOn    DateTime @db.Date
  /** Nabízená cena předplatného; u hráče se dá přepsat. */
  defaultPriceCents Int?
  /** Účetní druh příjmu předplatného — kam částka patří v uzávěrce. */
  incomeKind IncomeKind @default(TRAINING)
  createdAt DateTime @default(now())
  prepayments Prepayment[]

  @@unique([userId, name])
  @@unique([userId, number])
  @@index([userId, startsOn])
}

/**
 * Předplatné jednoho hráče na jedno období.
 *
 * Období je uložené u předplatného, ne u sezóny, schválně: hráč, který
 * nastoupí v půlce roku, má vlastní datum od, a pozdější sezóna nikdy
 * nepřepíše, co bylo předplacené dřív. Tréninky v období se hráči
 * neúčtují do měsíční platby — místo nich platí tuhle jednu částku.
 */
model Prepayment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  /** Null = období zadané ručně mimo číselník sezón. */
  seasonId  String?
  season    Season?  @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  startsOn  DateTime @db.Date
  endsOn    DateTime @db.Date
  /** 0 = jen vyjmutí z účtování, žádná platba se hráči nezobrazí. */
  amountCents Int    @default(0)
  vs        String   @unique
  incomeKind IncomeKind @default(TRAINING)
  note      String?
  paidAt    DateTime?
  createdAt DateTime @default(now())

  @@unique([playerId, seasonId])
  @@index([userId, startsOn])
  @@index([playerId])
}

/**
 * Souhrnná platba — hráč zaplatí víc položek jednou částkou.
 * Rozpad v položkách je to, co z ní dělá doložitelný účetní záznam.
 */
model PaymentBatch {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playerId   String
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  vs         String   @unique
  totalCents Int
  createdAt  DateTime @default(now())
  paidAt     DateTime?
  items      PaymentBatchItem[]

  @@index([userId, createdAt])
}

model PaymentBatchItem {
  id              String       @id @default(cuid())
  batchId         String
  batch           PaymentBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  kind            IncomeKind
  label           String
  amountCents     Int
  /** Odkud položka pochází — měsíc tréninků, akce, nebo předplacené období. */
  year            Int?
  month           Int?
  sharedPaymentId String?
  prepaymentId    String?

  @@index([batchId])
}

/** Označení „platba za měsíc dorazila“ — jeden záznam na hráče a kalendářní měsíc. */
model MonthlyPaymentMark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  year      Int
  month     Int
  createdAt DateTime @default(now())

  @@unique([userId, playerId, year, month])
  @@index([userId, year, month])
}

model PlayerGroupMembership {
  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  groupId  String
  group    Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([playerId, groupId])
  @@index([groupId])
}

/**
 * Rozvrh — pravidelné termíny klubu. Dřív byly úterý a čtvrtek napevno
 * v kódu a generátor uměl jen jeden čas pro oba dny, takže rozvrh
 * „úterý 18:00, čtvrtek 19:30“ jím nešel zadat vůbec.
 */
model TrainingSlot {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /** Den v týdnu jako v JS: 0 = neděle … 6 = sobota. */
  dayOfWeek Int
  /** Minuty od půlnoci — snadno se řadí i porovnává. */
  startMinutes Int
  endMinutes   Int
  kind      TrainingKind @default(TRAINING)
  /** Cena za tento termín. Zvýhodněné kategorie platí dál svou sazbu. */
  priceCents Int
  /** Vypnutý termín se nenabízí ke generování, ale historii nechává být. */
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  trainings Training[]

  @@unique([userId, dayOfWeek, startMinutes])
  @@index([userId, dayOfWeek])
}

model Training {
  id                String       @id @default(cuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  startsAt          DateTime
  kind              TrainingKind @default(TRAINING)
  /** Konec tréninku. Null u starších záznamů, kdy se délka neevidovala. */
  endsAt            DateTime?
  /** Z jakého termínu rozvrhu vznikl. Null = ručně přidaný. */
  slotId            String?
  slot              TrainingSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  cancelled         Boolean      @default(false)
  notes             String?
  /** Null = automatická cena podle dne. Není null = cena za tento trénink (z rozvrhu nebo ručně). */
  defaultPriceCents Int?
  attendances       Attendance[]
  blocks            TrainingBlock[]
  matches           Match[]

  @@index([userId, startsAt])
}

/** Druh cvičení — kvůli řazení a filtrování v knihovně. */
enum DrillKind {
  WARMUP
  DRILL
  GAME
  COOLDOWN
}

/**
 * Knihovna cvičení. Trenér si ji plní postupně a pak z ní skládá
 * plány jednotlivých tréninků, místo aby psal přípravu znovu do telefonu.
 */
model Drill {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  /** Nabídne se jako délka při vložení do plánu. */
  defaultMinutes Int?
  kind           DrillKind @default(DRILL)
  /** Co je na cvičení potřeba — míče, kužely… */
  equipment      String?
  /** Archivované se nenabízí, ale zůstává v už hotových plánech. */
  archived       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  blocks         TrainingBlock[]

  @@unique([userId, name])
  @@index([userId, archived])
}

/**
 * Jeden bod plánu tréninku. Buď odkazuje na cvičení z knihovny, nebo
 * stojí sám (jednorázová věc, kterou nemá smysl ukládat).
 */
model TrainingBlock {
  id         String    @id @default(cuid())
  trainingId String
  training   Training  @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  /** Null = bod mimo knihovnu, nebo cvičení mezitím smazané. */
  drillId    String?
  drill      Drill?    @relation(fields: [drillId], references: [id], onDelete: SetNull)
  /** Vlastní název bodu. Kopíruje se z cvičení, dá se přepsat. */
  title      String
  notes      String?
  minutes    Int
  kind       DrillKind @default(DRILL)
  sortOrder  Int
  /**
   * Rozdělení do týmů u herních bodů: [{ "name": "…", "playerIds": [...] }].
   * Schválně jako JSON, ne tabulka — je to momentka jednoho večera,
   * nic se přes ni nevykazuje a hráč smazaný ze soupisky se prostě
   * při čtení přeskočí.
   */
  teams      Json?

  @@index([trainingId, sortOrder])
}

model Attendance {
  id         String           @id @default(cuid())
  trainingId String
  training   Training         @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  playerId   String
  player     Player           @relation(fields: [playerId], references: [id], onDelete: Cascade)
  status     AttendanceStatus @default(ABSENT)

  @@unique([trainingId, playerId])
}

model SharedPayment {
  id               String                     @id @default(cuid())
  userId           String
  user             User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  totalAmountCents Int
  /** Pořadové číslo akce v klubu — druhá část variabilního symbolu. */
  number           Int
  /** Účetní druh příjmu této akce — určuje, kam částka patří v uzávěrce. */
  incomeKind       IncomeKind                 @default(EVENT)
  archived         Boolean                    @default(false)
  createdAt        DateTime                   @default(now())
  participants     SharedPaymentParticipant[]

  @@unique([userId, number])
  @@index([userId, archived])
}

model SharedPaymentParticipant {
  id              String        @id @default(cuid())
  sharedPaymentId String
  sharedPayment   SharedPayment @relation(fields: [sharedPaymentId], references: [id], onDelete: Cascade)
  playerId        String
  player          Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  amountCents     Int
  paidAt          DateTime?

  @@unique([sharedPaymentId, playerId])
}

/** Jak se akce počítá — do našeho sloupce, soupeřova, nebo mimo. */
enum ReviewSide {
  FOR
  AGAINST
  NEUTRAL
}

/**
 * Rozbor zápasu z videa. Proti modelu Match nerozdává rating —
 * je to poznámkový blok navázaný na časovou osu záznamu. Proto je
 * to samostatná věc a ne příznak u zápasu: rozebírá se i to, co se
 * nehrálo na tréninku, a naopak zápas z tréninku rozbor mít nemusí.
 */
model VideoReview {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  opponent  String?
  playedOn  DateTime @db.Date
  /** Jedenáctiznakové ID z odkazu. Ukládá se rozparsované, ne celá URL. */
  videoId   String?
  notes     String?
  /** Nepovinná vazba, když se rozebírá zápas odehraný na tréninku. */
  matchId   String?
  match     Match?   @relation(fields: [matchId], references: [id], onDelete: SetNull)
  /** Zkratka pro „vidí to celý tým“ — jinak rozhodují záznamy v shares. */
  sharedAll Boolean  @default(false)
  createdAt DateTime @default(now())
  events    ReviewEvent[]
  shares    ReviewShare[]
  roster    ReviewRoster[]

  @@index([userId, playedOn])
}

/**
 * Soupiska rozboru — kdo u tohohle zápasu hrál.
 *
 * Klub má dvacet lidí, na turnaj jich jede deset. Bez soupisky by se
 * při zapisování proklikávalo dvacet jmen, z toho polovina tam vůbec
 * nebyla. Prázdná soupiska znamená „všichni“: staré rozbory fungují
 * dál a nový jde začít bez vyplňování.
 */
model ReviewRoster {
  reviewId String
  review   VideoReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  playerId String
  player   Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([reviewId, playerId])
  @@index([playerId])
}

/**
 * Tlačítko počítadla. Definuje se pro celý klub, ne pro jeden rozbor —
 * jinak by stejná akce měla v každém zápase jiný název a statistika
 * napříč zápasy by nedávala smysl.
 */
model ReviewEventType {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  /** Hex z klubové palety, vybírá se ze seznamu, nepíše se ručně. */
  color     String
  side      ReviewSide @default(NEUTRAL)
  /**
   * Nadřazená skupina, třeba HIT nebo DEAD. Kvůli vyhodnocení: samotný
   * počet „Hit counter fast“ nic neřekne, teprve podíl na všech hitech
   * ukáže, co funguje. Prázdné = tlačítko stojí samo.
   */
  groupLabel String?
  sortOrder Int        @default(0)
  /**
   * Smazané tlačítko se jen archivuje. Kdyby se mazalo doopravdy,
   * ztratily by smysl všechny zápisy, které na něj odkazují.
   */
  archived  Boolean    @default(false)
  events    ReviewEvent[]

  @@index([userId, archived])
}

/** Jedno kliknutí: čas ve videu, typ akce, volitelně hráč a poznámka. */
model ReviewEvent {
  id         String          @id @default(cuid())
  reviewId   String
  review     VideoReview     @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  typeId     String
  type       ReviewEventType @relation(fields: [typeId], references: [id], onDelete: Restrict)
  /** Sekunda ve videu. Celé číslo stačí, přesnost na desetiny je zbytečná. */
  atSeconds  Int
  playerId   String?
  player     Player?         @relation(fields: [playerId], references: [id], onDelete: SetNull)
  note       String?
  createdAt  DateTime        @default(now())

  @@index([reviewId, atSeconds])
  @@index([playerId])
}

/** Komu je rozbor zpřístupněný v hráčském portálu. */
model ReviewShare {
  reviewId String
  review   VideoReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  playerId String
  player   Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([reviewId, playerId])
  @@index([playerId])
}
